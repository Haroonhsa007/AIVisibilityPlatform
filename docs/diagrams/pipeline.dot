digraph Pipeline {
  graph [rankdir=TB, bgcolor="#f5f7fa", pad="0.45", nodesep="0.35", ranksep="0.4", fontname="Arial", fontsize=24, fontcolor="#0f172a", label="One pipeline run: persisted state, validated output", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e1", fontname="Arial", fontsize=18, fontcolor="#0f172a", margin="0.18,0.16"];
  edge [color="#64748b", fontname="Arial", fontsize=12, fontcolor="#475569", arrowsize=0.7];
  queued [label="Queued\nPOST returns 202"];
  discovery [label="Discovery\nGenerate questions\nValidate + upsert"];
  scoring [label="Scoring\nBatches of ≤5\nDerive visibility + score"];
  recommendations [label="Recommendations\nTop absent-domain queries\nValidate target UUIDs"];
  completed [label="Completed\nUsable results, no warnings", fillcolor="#dcfce7", color="#86efac"];
  partial [label="Partial\nUsable scores + warnings", fillcolor="#fef3c7", color="#fcd34d"];
  failed [label="Failed\nDiscovery failure or no scores", fillcolor="#fee2e2", color="#fca5a5"];
  { rank=same; queued; discovery; scoring; recommendations; }
  { rank=same; failed; partial; completed; }
  queued -> discovery [label="worker claims"];
  discovery -> scoring -> recommendations;
  recommendations -> completed;
  recommendations -> partial;
  discovery -> failed [label="fatal failure"];
  scoring -> failed [label="no scored queries"];
}
