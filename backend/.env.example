# Copy to .env; never put real credentials in this example.
FLASK_APP=wsgi:app
FLASK_ENV=development
DATABASE_URL=sqlite:///dev.db
# Only needed in queue mode. Blank disables Redis configuration.
REDIS_URL=
PIPELINE_EXECUTION=eager
SCORING_CONCURRENCY=4
RECOMMENDATION_TOP_N=8
RUN_STALE_MINUTES=30
JOB_TIMEOUT_SECONDS=900
CORS_ORIGINS=http://localhost:4200
SECRET_KEY=
# Fake is offline. For a live provider, set its name and only its local key.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Blank selects provider defaults in config.py.
DISCOVERY_MODEL=
SCORING_MODEL=
RECOMMENDATION_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=3
LLM_RETRY_MIN_SECONDS=1
LLM_RETRY_MAX_SECONDS=8
